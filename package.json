{
  "name": "hsps-point-bank",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ipad": "vite --mode ipad",
    "dev:emulator": "vite --mode emulator",
    "emulators": "firebase emulators:start --project demo-hsps-point-bank --only auth,firestore",
    "admin": "vite-node scripts/admin.ts --",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/api",
    "test:e2e": "playwright test",
    "test:firebase": "node scripts/free-emulator-ports.mjs && firebase emulators:exec --project demo-hsps-point-bank --only auth,firestore \"vitest run --config vitest.firebase.config.ts\"",
    "test:e2e:firebase": "node scripts/free-emulator-ports.mjs && playwright test --config playwright.firebase.config.ts && node scripts/free-emulator-ports.mjs",
    "test:all": "npm run typecheck && npm run test && npm run test:firebase && npm run test:e2e && npm run test:e2e:firebase && npm run build",
    "report": "node scripts/make-test-report.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.27.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
